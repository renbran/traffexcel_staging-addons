<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════
         1. Extend account.payment form — add PDC tab
    ══════════════════════════════════════════════════════════════ -->
    <record id="view_account_payment_pdc_form" model="ir.ui.view">
        <field name="name">account.payment.pdc.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">

            <!-- PDC workflow buttons after the existing Confirm button -->
            <xpath expr="//button[@name='action_post']" position="after">
                <button name="action_pdc_receive" type="object"
                    string="Mark Received / Issued" class="btn-primary"
                    invisible="not is_pdc or pdc_status != 'draft'"/>
                <button name="action_pdc_deposit" type="object"
                    string="Deposit to Bank" class="btn-primary"
                    invisible="not is_pdc or pdc_status != 'received'"/>
                <button name="action_pdc_clear" type="object"
                    string="Mark Cleared" class="btn-success"
                    invisible="not is_pdc or pdc_status != 'deposited'"/>
                <button name="action_pdc_bounce" type="object"
                    string="Record Bounce" class="btn-danger"
                    invisible="not is_pdc or pdc_status != 'deposited'"/>
                <button name="action_print_pdc_slip" type="object"
                    string="Print PDC Slip" class="btn-secondary"
                    invisible="not is_pdc"/>
            </xpath>

            <!-- PDC status bar injected into the existing statusbar -->
            <xpath expr="//field[@name='state'][@widget='statusbar']" position="after">
                <field name="pdc_status" widget="statusbar"
                    statusbar_visible="draft,received,deposited,cleared"
                    invisible="not is_pdc"/>
            </xpath>

            <!-- PDC toggle + reference after the memo field -->
            <xpath expr="//field[@name='memo']" position="after">
                <field name="is_pdc" string="PDC / BG" widget="boolean_toggle"/>
                <field name="pdc_reference" string="PDC Reference"
                    invisible="not is_pdc" readonly="1"
                    placeholder="Auto-generated on save"/>
            </xpath>

            <!-- PDC details tab inside the payment notebook -->
            <xpath expr="//notebook[@name='payment_notebook']" position="inside">
                <page string="PDC / BG Details" name="pdc_details" invisible="not is_pdc">

                    <group string="Instrument Information">
                        <group>
                            <field name="pdc_type"
                                required="is_pdc"/>
                            <field name="pdc_cheque_no" placeholder="e.g. 001234"/>
                            <field name="pdc_due_date"/>
                            <field name="pdc_days_to_due" string="Days to Due"
                                invisible="not pdc_due_date"/>
                        </group>
                        <group>
                            <field name="pdc_bank_name" placeholder="e.g. Emirates NBD"/>
                            <field name="pdc_bank_branch" placeholder="Branch name"/>
                            <field name="pdc_drawer_name"
                                placeholder="Name on cheque (if different from partner)"/>
                            <field name="pdc_beneficiary"
                                placeholder="Beneficiary name"/>
                        </group>
                    </group>

                    <group string="Bank Guarantee / Bond Details"
                        invisible="pdc_type not in ['bank_guarantee','performance_bond']">
                        <group>
                            <field name="pdc_bg_number" placeholder="BG / Bond reference"/>
                            <field name="pdc_bg_issuing_bank"/>
                        </group>
                        <group>
                            <field name="pdc_bg_expiry_date"/>
                        </group>
                    </group>

                    <group string="Project &amp; Tracking">
                        <group>
                            <field name="pdc_project_id"/>
                        </group>
                        <group>
                            <field name="pdc_deposit_date" readonly="1"
                                invisible="not pdc_deposit_date"/>
                            <field name="pdc_clearing_date" readonly="1"
                                invisible="not pdc_clearing_date"/>
                            <field name="pdc_bounce_date" readonly="1"
                                invisible="not pdc_bounce_date"/>
                            <field name="pdc_bounce_reason" readonly="1"
                                invisible="not pdc_bounce_reason"/>
                        </group>
                    </group>

                    <group string="Notes">
                        <field name="pdc_notes" nolabel="1" colspan="2"
                            placeholder="Internal remarks, conditions, bank contact…"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         2. PDC List view (standalone)
    ══════════════════════════════════════════════════════════════ -->
    <record id="view_pdc_payment_list" model="ir.ui.view">
        <field name="name">account.payment.pdc.list</field>
        <field name="model">account.payment</field>
        <field name="arch" type="xml">
            <list string="PDC Register"
                  decoration-danger="pdc_is_overdue == True"
                  decoration-success="pdc_status == 'cleared'"
                  decoration-muted="pdc_status == 'bounced'">
                <field name="pdc_reference"/>
                <field name="pdc_type"/>
                <field name="partner_id" string="Partner"/>
                <field name="pdc_project_id" string="Project"/>
                <field name="pdc_cheque_no"/>
                <field name="pdc_bank_name"/>
                <field name="pdc_due_date"/>
                <field name="pdc_days_to_due" string="Days to Due"/>
                <field name="amount" string="Amount (AED)"/>
                <field name="pdc_status" widget="badge"
                    decoration-info="pdc_status == 'received'"
                    decoration-warning="pdc_status == 'deposited'"
                    decoration-success="pdc_status == 'cleared'"
                    decoration-danger="pdc_status == 'bounced'"/>
                <field name="pdc_is_overdue" column_invisible="1"/>
                <button name="action_pdc_receive" type="object" string="Receive"
                    invisible="pdc_status != 'draft'" icon="fa-check"/>
                <button name="action_pdc_deposit" type="object" string="Deposit"
                    invisible="pdc_status != 'received'" icon="fa-university"/>
                <button name="action_pdc_clear" type="object" string="Clear"
                    invisible="pdc_status != 'deposited'" icon="fa-check-circle"/>
                <button name="action_print_pdc_slip" type="object"
                    string="Print" icon="fa-print"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         3. PDC Search view
    ══════════════════════════════════════════════════════════════ -->
    <record id="view_pdc_payment_search" model="ir.ui.view">
        <field name="name">account.payment.pdc.search</field>
        <field name="model">account.payment</field>
        <field name="arch" type="xml">
            <search string="Search PDC">
                <field name="pdc_reference" string="PDC Ref"/>
                <field name="partner_id" string="Partner"/>
                <field name="pdc_cheque_no" string="Cheque No."/>
                <field name="pdc_bank_name" string="Bank"/>
                <separator/>
                <filter string="Customer PDC" name="filter_customer_cheque"
                    domain="[('pdc_type','=','customer_cheque')]"/>
                <filter string="Vendor PDC" name="filter_vendor_cheque"
                    domain="[('pdc_type','=','vendor_cheque')]"/>
                <filter string="Bank Guarantees" name="filter_bg"
                    domain="[('pdc_type','=','bank_guarantee')]"/>
                <filter string="Performance Bonds" name="filter_bond"
                    domain="[('pdc_type','=','performance_bond')]"/>
                <separator/>
                <filter string="Received / Issued" name="filter_received"
                    domain="[('pdc_status','=','received')]"/>
                <filter string="Deposited" name="filter_deposited"
                    domain="[('pdc_status','=','deposited')]"/>
                <filter string="Cleared" name="filter_cleared"
                    domain="[('pdc_status','=','cleared')]"/>
                <filter string="Bounced" name="filter_bounced"
                    domain="[('pdc_status','=','bounced')]"/>
                <separator/>
                <filter string="PDC Type"  name="group_type"   domain="[]" context="{'group_by':'pdc_type'}"/>
                <filter string="Status"    name="group_status" domain="[]" context="{'group_by':'pdc_status'}"/>
                <filter string="Project"   name="group_proj"   domain="[]" context="{'group_by':'pdc_project_id'}"/>
                <filter string="Bank"      name="group_bank"   domain="[]" context="{'group_by':'pdc_bank_name'}"/>
                <filter string="Due Month" name="group_month"  domain="[]" context="{'group_by':'pdc_due_date:month'}"/>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         4. PDC Kanban view
    ══════════════════════════════════════════════════════════════ -->
    <record id="view_pdc_payment_kanban" model="ir.ui.view">
        <field name="name">account.payment.pdc.kanban</field>
        <field name="model">account.payment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="pdc_status" class="o_kanban_small_column">
                <field name="pdc_reference"/>
                <field name="partner_id"/>
                <field name="pdc_cheque_no"/>
                <field name="pdc_due_date"/>
                <field name="amount"/>
                <field name="pdc_status"/>
                <field name="pdc_type"/>
                <field name="pdc_is_overdue"/>
                <field name="pdc_project_id"/>
                <templates>
                    <t t-name="kanban-card">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click #{record.pdc_is_overdue.raw_value ? 'border-danger' : ''}">
                            <div class="o_kanban_record_top mb4">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <t t-esc="record.pdc_reference.value"/>
                                    </strong>
                                </div>
                                <span class="badge rounded-pill text-bg-info fs-6">
                                    <t t-esc="record.amount.value"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><i class="fa fa-user me-1"/><t t-esc="record.partner_id.value"/></div>
                                <div><i class="fa fa-file-text-o me-1"/>Cheque: <t t-esc="record.pdc_cheque_no.value or '—'"/></div>
                                <div><i class="fa fa-calendar me-1"/>Due: <t t-esc="record.pdc_due_date.value or '—'"/></div>
                                <t t-if="record.pdc_project_id.value">
                                    <div><i class="fa fa-building me-1"/><t t-esc="record.pdc_project_id.value"/></div>
                                </t>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <span t-attf-class="badge #{record.pdc_is_overdue.raw_value ? 'text-bg-danger' : 'text-bg-secondary'}">
                                    <t t-esc="record.pdc_type.value"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         5. Bounce Wizard form
    ══════════════════════════════════════════════════════════════ -->
    <record id="view_pdc_bounce_wizard_form" model="ir.ui.view">
        <field name="name">sgc.pdc.bounce.wizard.form</field>
        <field name="model">sgc.pdc.bounce.wizard</field>
        <field name="arch" type="xml">
            <form string="Record PDC Bounce / Return">
                <group>
                    <field name="payment_id" readonly="1"/>
                    <field name="bounce_date"/>
                    <field name="bounce_reason"
                        placeholder="e.g. Insufficient funds, Signature mismatch…"/>
                </group>
                <footer>
                    <button name="action_confirm_bounce" type="object"
                        string="Confirm Bounce" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         6. Override standard Accounting payment menu filters
         — separate customer (inbound) from vendor (outbound) strictly
    ══════════════════════════════════════════════════════════════ -->
    <record id="account.action_account_payments" model="ir.actions.act_window">
        <field name="domain">[('payment_type','=','inbound')]</field>
        <field name="context">{'default_payment_type': 'inbound', 'default_partner_type': 'customer', 'search_default_inbound_filter': 1, 'default_move_journal_types': ('bank', 'cash'), 'display_account_trust': True}</field>
    </record>

    <record id="account.action_account_payments_payable" model="ir.actions.act_window">
        <field name="domain">[('payment_type','=','outbound')]</field>
        <field name="context">{'default_payment_type': 'outbound', 'default_partner_type': 'supplier', 'search_default_outbound_filter': 1, 'default_move_journal_types': ('bank', 'cash'), 'display_account_trust': True}</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         7. PDC window actions
    ══════════════════════════════════════════════════════════════ -->
    <record id="action_pdc_all" model="ir.actions.act_window">
        <field name="name">PDC Register</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_pdc','=',True)]</field>
        <field name="context">{'default_is_pdc': True, 'search_default_filter_received': 1}</field>
        <field name="view_ids" eval="[
            (5,0,0),
            (0,0,{'view_mode':'list',   'view_id': ref('view_pdc_payment_list')}),
            (0,0,{'view_mode':'kanban', 'view_id': ref('view_pdc_payment_kanban')}),
            (0,0,{'view_mode':'form',   'view_id': ref('view_account_payment_pdc_form')}),
        ]"/>
        <field name="search_view_id" ref="view_pdc_payment_search"/>
    </record>

    <record id="action_pdc_customer" model="ir.actions.act_window">
        <field name="name">Customer PDC</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_pdc','=',True),('payment_type','=','inbound')]</field>
        <field name="context">{'default_is_pdc': True, 'default_payment_type': 'inbound'}</field>
        <field name="view_ids" eval="[
            (5,0,0),
            (0,0,{'view_mode':'list',   'view_id': ref('view_pdc_payment_list')}),
            (0,0,{'view_mode':'kanban', 'view_id': ref('view_pdc_payment_kanban')}),
        ]"/>
        <field name="search_view_id" ref="view_pdc_payment_search"/>
    </record>

    <record id="action_pdc_vendor" model="ir.actions.act_window">
        <field name="name">Vendor PDC</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_pdc','=',True),('payment_type','=','outbound')]</field>
        <field name="context">{'default_is_pdc': True, 'default_payment_type': 'outbound'}</field>
        <field name="view_ids" eval="[
            (5,0,0),
            (0,0,{'view_mode':'list',   'view_id': ref('view_pdc_payment_list')}),
            (0,0,{'view_mode':'kanban', 'view_id': ref('view_pdc_payment_kanban')}),
        ]"/>
        <field name="search_view_id" ref="view_pdc_payment_search"/>
    </record>

    <record id="action_pdc_bank_guarantees" model="ir.actions.act_window">
        <field name="name">Bank Guarantees</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_pdc','=',True),('pdc_type','=','bank_guarantee')]</field>
        <field name="context">{'default_is_pdc': True, 'default_pdc_type': 'bank_guarantee'}</field>
        <field name="view_ids" eval="[
            (5,0,0),
            (0,0,{'view_mode':'list', 'view_id': ref('view_pdc_payment_list')}),
        ]"/>
        <field name="search_view_id" ref="view_pdc_payment_search"/>
    </record>

    <record id="action_pdc_performance_bonds" model="ir.actions.act_window">
        <field name="name">Performance Bonds</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_pdc','=',True),('pdc_type','=','performance_bond')]</field>
        <field name="context">{'default_is_pdc': True, 'default_pdc_type': 'performance_bond'}</field>
        <field name="view_ids" eval="[
            (5,0,0),
            (0,0,{'view_mode':'list', 'view_id': ref('view_pdc_payment_list')}),
        ]"/>
        <field name="search_view_id" ref="view_pdc_payment_search"/>
    </record>

</odoo>
