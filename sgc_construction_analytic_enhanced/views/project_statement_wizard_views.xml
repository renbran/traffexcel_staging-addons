<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_statement_wizard_form" model="ir.ui.view">
        <field name="name">traffexcel.project.statement.wizard.form</field>
        <field name="model">traffexcel.project.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Project Statement">
                <group>
                    <group name="dates" string="Period">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group name="options" string="Options">
                        <field name="vat_mode"/>
                        <field name="entry_state"/>
                    </group>
                </group>
                <footer>
                    <button name="action_download_xlsx"
                            string="Download XLSX"
                            type="object"
                            class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_project_statement_wizard" model="ir.actions.act_window">
        <field name="name">Project Statement (XLSX)</field>
        <field name="res_model">traffexcel.project.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_project_statement_xlsx"
              name="Project Statement (XLSX)"
              parent="account.account_reports_management_menu"
              action="action_project_statement_wizard"
              sequence="26"/>

</odoo>