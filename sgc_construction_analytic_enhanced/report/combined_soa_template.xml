<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_combined_soa">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="sgc_construction_management.construction_external_layout">
                    <div class="page sgc-report">
                        <div class="oe_structure"/>

                        <div class="row mt-4">
                            <div class="col-12 text-center">
                                <h2>STATEMENT OF ACCOUNT</h2>
                                <h4 t-field="o.project_id.name"/>
                                <span>Reference: <t t-field="o.name"/></span>
                            </div>
                        </div>

                        <div class="row mt-4 mb-3">
                            <div class="col-6">
                                <strong>Client:</strong> <span t-field="o.project_id.client_id"/><br/>
                                <strong>Contract:</strong> <span t-field="o.project_id.ref"/><br/>
                                <strong>Billing Date:</strong> <span t-field="o.billing_date"/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Status:</strong> <span t-field="o.state"/><br/>
                                <strong>Amount:</strong>
                                <span t-field="o.total_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </div>
                        </div>

                        <h4 class="border-bottom pb-1">Billing Lines</h4>
                        <table class="table table-sm o_main_table mt-2">
                            <thead>
                                <tr>
                                    <th>SCO / Work Item</th>
                                    <th class="text-end">Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td><span t-field="line.description"/></td>
                                    <td class="text-end"><span t-field="line.quantity"/></td>
                                    <td class="text-end"><span t-field="line.unit_price" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                    <td class="text-end"><span t-field="line.total_price" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold">
                                    <td colspan="3" class="text-end">Total</td>
                                    <td class="text-end">
                                        <span t-field="o.total_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <div class="row mt-5">
                            <div class="col-6">
                                <hr/>
                                <p class="text-center">Client Signature</p>
                            </div>
                            <div class="col-6">
                                <hr/>
                                <p class="text-center">Contractor Signature</p>
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-12">
                                <small>Notes: <span t-field="o.notes"/></small>
                            </div>
                        </div>

                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>