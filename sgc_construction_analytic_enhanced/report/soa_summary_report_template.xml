<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_soa_summary">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="sgc_construction_management.construction_external_layout">
                    <t t-set="data" t-value="report_data[o.id]"/>
                    <div class="page sgc-report">
                        <div class="oe_structure"/>

                        <div class="row mt-4 mb-4">
                            <div class="col-12 text-center">
                                <h2 class="fw-bold">PROJECT SUMMARY</h2>
                                <h4 t-field="o.name"/>
                                <span t-field="o.ref"/>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-6">
                                <strong>Client:</strong> <span t-field="o.client_id"/><br/>
                                <strong>Location:</strong> <span t-field="o.location"/><br/>
                                <strong>Project Manager:</strong> <span t-field="o.project_manager_id"/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Contract Value:</strong>
                                <span t-field="o.contract_value" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/><br/>
                                <strong>Start Date:</strong> <span t-field="o.start_date"/><br/>
                                <strong>End Date:</strong> <span t-field="o.end_date"/><br/>
                                <strong>Status:</strong> <span t-field="o.state"/>
                            </div>
                        </div>

                        <h4 class="mt-4 border-bottom pb-2">Financial Summary</h4>
                        <table class="table table-sm o_main_table mt-2">
                            <thead>
                                <tr>
                                    <th>Metric</th>
                                    <th class="text-end">Amount</th>
                                    <th class="text-end">%</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>Contract Value</strong></td>
                                    <td class="text-end">
                                        <span t-field="o.contract_value" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                    <td class="text-end">100%</td>
                                </tr>
                                <tr>
                                    <td>Total Revenue (Billed)</td>
                                    <td class="text-end">
                                        <span t-esc="data['total_revenue']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                    <td class="text-end">
                                        <t t-esc="'%.1f%%' % ((data['total_revenue'] / o.contract_value * 100) if o.contract_value else 0.0)"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Total Expenses</td>
                                    <td class="text-end">
                                        <span t-esc="data['total_expenses']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                    <td class="text-end">
                                        <t t-esc="'%.1f%%' % ((data['total_expenses'] / o.contract_value * 100) if o.contract_value else 0.0)"/>
                                    </td>
                                </tr>
                                <tr class="fw-bold border-top">
                                    <td>Project Margin</td>
                                    <td class="text-end">
                                        <span t-esc="data['total_revenue'] - data['total_expenses']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                    <td class="text-end">
                                        <t t-esc="'%.1f%%' % (((data['total_revenue'] - data['total_expenses']) / o.contract_value * 100) if o.contract_value else 0.0)"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="row mt-4">
                            <div class="col-6">
                                <h5 class="border-bottom pb-1">Progress</h5>
                                <p><strong>Progress:</strong> <span t-field="o.progress"/>%</p>
                                <p><strong>Billing:</strong> <span t-field="o.billing_percent"/>%</p>
                                <p><strong>Receipt:</strong> <span t-field="o.receipt_percent"/>%</p>
                            </div>
                            <div class="col-6">
                                <h5 class="border-bottom pb-1">Counts</h5>
                                <p><strong>Customer Invoices:</strong> <t t-esc="data['invoice_count']"/></p>
                                <p><strong>Vendor Bills:</strong> <t t-esc="data['bill_count']"/></p>
                                <p><strong>RA Billings:</strong> <span t-field="o.billing_count"/></p>
                            </div>
                        </div>

                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>