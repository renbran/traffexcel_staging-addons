<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add Construction Project search tools to analytic lines -->
    <record id="view_analytic_line_filter_construction" model="ir.ui.view">
        <field name="name">account.analytic.line.select.construction</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_filter"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="x_plan2_id" string="Construction Project"/>
                <field name="account_id"/>
                <field name="partner_id"/>
                <field name="move_line_id"/>
            </field>
            <filter name="month" position="after">
                <separator/>
                <filter string="Construction Projects"
                        name="construction_projects"
                        domain="[('x_plan2_id', '!=', False)]"/>
                <filter string="Posted Entries"
                        name="posted_entries"
                        domain="[('move_line_id.move_id.state', '=', 'posted')]"/>
                <filter string="Draft Entries"
                        name="draft_entries"
                        domain="[('move_line_id.move_id.state', '=', 'draft')]"/>
            </filter>
            <filter name="group_date" position="after">
                <filter string="Construction Project"
                        name="group_by_construction_project"
                        context="{'group_by': 'x_plan2_id'}"/>
                <filter string="Analytic Account"
                        name="group_by_analytic_account"
                        context="{'group_by': 'account_id'}"/>
            </filter>
        </field>
    </record>

    <!-- Predefine the Analytic Report: filter + group by Construction Project -->
    <record id="account.action_analytic_reporting" model="ir.actions.act_window">
        <field name="context">{
            'search_default_construction_projects': 1,
            'search_default_group_by_construction_project': 1,
        }</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <!-- Project Statement wizard + menu live in project_statement_wizard_views.xml -->

</odoo>
