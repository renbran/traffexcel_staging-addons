<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_proforma_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="sgc_construction_management.construction_external_layout">
                    <div class="page sgc-report">
                        <div class="oe_structure"/>

                        <div class="row mt-4 mb-4">
                            <div class="col-12 text-center">
                                <h2 class="fw-bold" style="color: #dc3545;">PROFORMA INVOICE</h2>
                                <h4 t-field="o.name"/>
                                <span>RA No.: <span t-field="o.ra_number"/></span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-6">
                                <strong>Client:</strong> <span t-field="o.project_id.client_id"/><br/>
                                <strong>Project:</strong> <span t-field="o.project_id.name"/><br/>
                                <strong>Project Code:</strong> <span t-field="o.project_id.ref"/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Billing Date:</strong> <span t-field="o.billing_date"/><br/>
                                <strong>Period:</strong>
                                <span t-field="o.billing_period_start"/> to <span t-field="o.billing_period_end"/><br/>
                                <strong>Billing Ref:</strong> <span t-field="o.ref"/>
                            </div>
                        </div>

                        <h4 class="mt-4 border-bottom pb-2">Billing Lines</h4>
                        <table class="table table-sm o_main_table table-striped mt-2">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Description</th>
                                    <th>Work Type</th>
                                    <th class="text-end">BOQ Qty</th>
                                    <th class="text-end">Prev. Qty</th>
                                    <th class="text-end">Current Qty</th>
                                    <th class="text-end">Unit Rate</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="idx" t-value="0"/>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <tr>
                                        <td><t t-esc="idx + 1"/><t t-set="idx" t-value="idx + 1"/></td>
                                        <td><span t-field="line.boq_line_description"/></td>
                                        <td><span t-field="line.work_type"/></td>
                                        <td class="text-end"><span t-field="line.boq_qty"/></td>
                                        <td class="text-end"><span t-field="line.qty_previous"/></td>
                                        <td class="text-end"><span t-field="line.qty_current"/></td>
                                        <td class="text-end">
                                            <span t-field="line.unit_rate" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="row mt-4">
                            <div class="col-6 offset-6">
                                <table class="table table-sm">
                                    <tr>
                                        <td><strong>Total Amount (before retention):</strong></td>
                                        <td class="text-end">
                                            <span t-field="o.total_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Less: Previous Billed:</td>
                                        <td class="text-end">
                                            <span t-field="o.previous_billed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Net Amount:</td>
                                        <td class="text-end">
                                            <span t-field="o.net_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Retention (<span t-field="o.retention_percent"/>%):</td>
                                        <td class="text-end">
                                            <span t-field="o.retention_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr class="fw-bold fs-5 border-top">
                                        <td>NET PAYABLE:</td>
                                        <td class="text-end">
                                            <span t-field="o.net_payable" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div class="row mt-5">
                            <div class="col-12">
                                <p><em>This is a computer-generated proforma invoice and does not require a signature.</em></p>
                            </div>
                        </div>

                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>