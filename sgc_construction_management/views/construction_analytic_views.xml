<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================ -->
    <!-- ACTIONS                                      -->
    <!-- ============================================ -->

    <record id="action_construction_project_pnl" model="ir.actions.act_window">
        <field name="name">Project P&amp;L</field>
        <field name="res_model">construction.project.pnl</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No project P&amp;L data available.
            </p>
            <p>Project profitability data is computed from posted invoices and bills
               with analytic distribution linked to active construction projects.</p>
        </field>
    </record>

    <record id="action_construction_project_invoices" model="ir.actions.act_window">
        <field name="name">Invoices &amp; Bills by Project</field>
        <field name="res_model">construction.project.invoice.line</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No invoice or bill lines found.
            </p>
            <p>Invoice and bill lines with analytic distribution appear here,
               linked to active construction projects.</p>
        </field>
    </record>

    <record id="action_construction_project_analytic_lines" model="ir.actions.act_window">
        <field name="name">Analytic Lines by Project</field>
        <field name="res_model">construction.project.analytic.line</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No analytic lines found.
            </p>
            <p>Analytic lines are generated from posted invoices, bills, and payments
               with analytic distribution linked to active construction projects.</p>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- Construction Project P&L Views               -->
    <!-- ============================================ -->

    <record id="view_construction_project_pnl_form" model="ir.ui.view">
        <field name="name">construction.project.pnl.form</field>
        <field name="model">construction.project.pnl</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <div class="oe_button_box" name="buttons">
                        <button name="%(action_construction_project_invoices)d"
                                type="action" class="oe_stat_button"
                                icon="fa-file-text-o" string="Invoices &amp; Bills">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <group>
                        <group string="Project">
                            <field name="project_id"/>
                            <field name="analytic_account_name"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group string="Contract">
                            <field name="contract_value"/>
                            <field name="percent_complete" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Revenue" name="revenue">
                            <group>
                                <field name="total_revenue"/>
                                <field name="invoice_count"/>
                                <field name="revenue_received"/>
                                <field name="outstanding_revenue"/>
                            </group>
                        </page>
                        <page string="Costs" name="costs">
                            <group>
                                <field name="total_cogs"/>
                                <field name="bill_count"/>
                                <field name="bills_paid"/>
                                <field name="outstanding_payables"/>
                            </group>
                        </page>
                        <page string="Profitability" name="profit">
                            <group>
                                <field name="gross_profit"/>
                                <field name="total_payments_received"/>
                                <field name="total_payments_made"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_construction_project_pnl_list" model="ir.ui.view">
        <field name="name">construction.project.pnl.list</field>
        <field name="model">construction.project.pnl</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" decoration-danger="outstanding_revenue &gt; 0"
                  decoration-bf="gross_profit &gt; 0">
                <field name="project_id"/>
                <field name="contract_value"/>
                <field name="total_revenue" sum="Total"/>
                <field name="total_cogs" sum="Total"/>
                <field name="gross_profit" sum="Total"/>
                <field name="total_payments_received" sum="Total"/>
                <field name="outstanding_revenue"/>
                <field name="percent_complete" widget="progressbar"/>
            </list>
        </field>
    </record>

    <record id="view_construction_project_pnl_pivot" model="ir.ui.view">
        <field name="name">construction.project.pnl.pivot</field>
        <field name="model">construction.project.pnl</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="project_name" type="row"/>
                <field name="total_revenue" type="measure"/>
                <field name="total_cogs" type="measure"/>
                <field name="gross_profit" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_construction_project_pnl_graph" model="ir.ui.view">
        <field name="name">construction.project.pnl.graph</field>
        <field name="model">construction.project.pnl</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="project_name"/>
                <field name="total_revenue" type="measure"/>
                <field name="total_cogs" type="measure"/>
                <field name="gross_profit" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- Invoice/Bill Line Detail Views               -->
    <!-- ============================================ -->

    <record id="view_construction_project_invoice_line_list" model="ir.ui.view">
        <field name="name">construction.project.invoice.line.list</field>
        <field name="model">construction.project.invoice.line</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" decoration-info="move_type == 'out_invoice'"
                  decoration-warning="move_type == 'in_invoice'">
                <field name="project_name"/>
                <field name="invoice_ref"/>
                <field name="invoice_date"/>
                <field name="move_type" widget="badge"
                       decoration-success="move_type == 'out_invoice'"
                       decoration-warning="move_type == 'in_invoice'"/>
                <field name="payment_state" widget="badge"
                       decoration-success="payment_state == 'paid'"
                       decoration-warning="payment_state == 'partial'"
                       decoration-danger="payment_state == 'not_paid'"/>
                <field name="account_code"/>
                <field name="account_name"/>
                <field name="debit"/>
                <field name="credit"/>
                <field name="amount" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_construction_project_invoice_line_form" model="ir.ui.view">
        <field name="name">construction.project.invoice.line.form</field>
        <field name="model">construction.project.invoice.line</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Project">
                            <field name="project_name"/>
                            <field name="invoice_ref"/>
                            <field name="invoice_date"/>
                        </group>
                        <group string="Invoice Details">
                            <field name="move_id"/>
                            <field name="move_type"/>
                            <field name="payment_state"/>
                        </group>
                    </group>
                    <group>
                        <group string="Accounting">
                            <field name="account_code"/>
                            <field name="account_name"/>
                            <field name="amount"/>
                        </group>
                        <group string="Move Line">
                            <field name="line_description"/>
                            <field name="debit"/>
                            <field name="credit"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_construction_project_invoice_line_pivot" model="ir.ui.view">
        <field name="name">construction.project.invoice.line.pivot</field>
        <field name="model">construction.project.invoice.line</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="project_name" type="row"/>
                <field name="move_type" type="column"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- Analytic Line Detail Views                   -->
    <!-- ============================================ -->

    <record id="view_construction_project_analytic_line_list" model="ir.ui.view">
        <field name="name">construction.project.analytic.line.list</field>
        <field name="model">construction.project.analytic.line</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="project_name"/>
                <field name="date"/>
                <field name="description"/>
                <field name="account_code"/>
                <field name="account_name"/>
                <field name="amount" sum="Total"/>
                <field name="move_line_name"/>
            </list>
        </field>
    </record>

    <record id="view_construction_project_analytic_line_form" model="ir.ui.view">
        <field name="name">construction.project.analytic.line.form</field>
        <field name="model">construction.project.analytic.line</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Project">
                            <field name="project_name"/>
                            <field name="date"/>
                            <field name="description"/>
                        </group>
                        <group string="Amount">
                            <field name="amount"/>
                            <field name="account_code"/>
                            <field name="account_name"/>
                        </group>
                    </group>
                    <group>
                        <group string="Source Journal Item">
                            <field name="move_line_name"/>
                            <field name="move_debit"/>
                            <field name="move_credit"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_construction_project_analytic_line_pivot" model="ir.ui.view">
        <field name="name">construction.project.analytic.line.pivot</field>
        <field name="model">construction.project.analytic.line</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="project_name" type="row"/>
                <field name="date" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

</odoo>
